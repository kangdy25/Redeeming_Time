# Local development only. Copy this file to .env; never commit the result.
SECRET_KEY=replace-with-a-long-random-local-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
FRONTEND_ORIGIN=http://localhost:5173
# Leave redirect URI values empty locally to derive the callback from the API request host.
# In production, set each enabled provider's exact registered callback URI.
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_GOOGLE_REDIRECT_URI=
SOCIAL_AUTH_KAKAO_CLIENT_ID=
SOCIAL_AUTH_KAKAO_CLIENT_SECRET=
SOCIAL_AUTH_KAKAO_REDIRECT_URI=
SOCIAL_AUTH_STATE_TTL_SECONDS=600
SOCIAL_AUTH_HANDOFF_TTL_SECONDS=60
SOCIAL_AUTH_HTTP_TIMEOUT_SECONDS=10
# Set these with a transactional SMTP provider before enabling production
# password resets. The console backend prints reset links during local work.
PASSWORD_RESET_EMAIL_ENABLED=True
PASSWORD_RESET_TIMEOUT=3600
EMAIL_VERIFICATION_ENABLED=True
EMAIL_VERIFICATION_TIMEOUT=86400
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Redeeming Time <no-reply@localhost>
DATABASE_URL=sqlite:///db.sqlite3
CACHE_URL=locmemcache://redeeming-time
NUM_PROXIES=0
PLANNER_TIME_ZONE=Asia/Seoul
