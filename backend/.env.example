# Local development only. Copy this file to .env; never commit the result.
SECRET_KEY=replace-with-a-long-random-local-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
DATABASE_URL=sqlite:///db.sqlite3
CACHE_URL=locmemcache://redeeming-time
NUM_PROXIES=0
