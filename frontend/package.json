{
  "name": "frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "web",
    "app",
    "shared"
  ],
  "scripts": {
    "build:web": "npm --workspace @redeeming-time/web run build",
    "typecheck:app": "npm --workspace @redeeming-time/app run typecheck",
    "typecheck:shared": "npm --workspace @redeeming-time/shared run typecheck",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"{web,app,shared}/**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"{web,app,shared}/**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "msw": "^2.6.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "react-native-web": "^0.21.0"
  }
}
