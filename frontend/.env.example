# Local web development
VITE_API_BASE_URL=http://localhost:8000/api

# Vercel production uses the same-origin /api reverse proxy configured in
# vercel.json. This keeps browser OAuth traffic on the trusted frontend host.
# VITE_API_BASE_URL=/api

# Use your computer's LAN IP when running Expo on a physical device.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
